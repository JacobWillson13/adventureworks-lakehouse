{
  "datasets": [
    {
      "displayName": "kpis",
      "name": "2a99f965",
      "queryLines": [
        "-- kpis\n",
        "select sum(o.revenue) as revenue, count(*) as orders, sum(o.revenue)/count(*) as avg_order_value, sum(o.units) as units\n",
        "from workspace.aw_gold.fct_orders o\n",
        "join workspace.aw_gold.dim_date d on d.date_key = o.order_date_key\n",
        "where d.is_in_analysis_window"
      ]
    },
    {
      "displayName": "monthly_by_channel",
      "name": "185d2a84",
      "queryLines": [
        "-- monthly_by_channel\n",
        "select d.month_start_date, o.channel, sum(o.revenue) as revenue, count(*) as orders\n",
        "from workspace.aw_gold.fct_orders o\n",
        "join workspace.aw_gold.dim_date d on d.date_key = o.order_date_key\n",
        "where d.is_in_analysis_window\n",
        "group by d.month_start_date, o.channel"
      ]
    },
    {
      "displayName": "category_monthly",
      "name": "fb14daae",
      "queryLines": [
        "-- category_monthly\n",
        "select d.month_start_date, coalesce(p.category_name, 'Unassigned') as category_name, sum(l.revenue) as revenue, sum(l.order_qty) as units\n",
        "from workspace.aw_gold.fct_sales_lines l\n",
        "join workspace.aw_gold.dim_product p on p.product_id = l.product_id\n",
        "join workspace.aw_gold.dim_date d on d.date_key = l.order_date_key\n",
        "where d.is_in_analysis_window\n",
        "group by d.month_start_date, coalesce(p.category_name, 'Unassigned')"
      ]
    },
    {
      "displayName": "territory",
      "name": "d101f9f0",
      "queryLines": [
        "-- territory\n",
        "select t.territory_group, t.territory_name, o.channel, sum(o.revenue) as revenue, count(*) as orders\n",
        "from workspace.aw_gold.fct_orders o\n",
        "join workspace.aw_gold.dim_territory t on t.territory_id = o.territory_id\n",
        "join workspace.aw_gold.dim_date d on d.date_key = o.order_date_key\n",
        "where d.is_in_analysis_window\n",
        "group by t.territory_group, t.territory_name, o.channel"
      ]
    }
  ],
